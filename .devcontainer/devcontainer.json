// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "Ardour",
	"build": {
		"args": {
			"BASE_IMAGE": "mcr.microsoft.com/vscode/devcontainers/cpp:ubuntu-24.04"
		},
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": ".",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "Dockerfile"

	},
	
	"runArgs": [
		"--device=/dev/snd",
		"--env=DISPLAY=${localEnv:DISPLAY}",
		"--env=XAUTHORITY=/tmp/.Xauthority",
		"--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
		"--volume=${localEnv:XAUTHORITY}:/tmp/.Xauthority:ro"
	],
	"postCreateCommand": "sudo usermod -aG audio $USER && sudo setfacl -m u:$USER:rw /dev/snd/*",
	"mounts": [
		{
			"source": "${localEnv:HOME}",
			"target": "/home/vscode",
			"type": "bind"
		}
	],
	"remoteUser": "vscode",
	"updateRemoteUserUID": true,
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"ms-vscode.cpptools-extension-pack",
				"ms-azuretools.vscode-docker"
			]
		}
	}
}
