{
    "name": "Ardour",
    "build": {
        "args": {
            "BASE_IMAGE": "mcr.microsoft.com/vscode/devcontainers/cpp:ubuntu-24.04"
        },
        "context": ".",
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "-v",
        "/dev/snd:/dev/snd",
        "--device-cgroup-rule=c 116:* rwm",
        "--security-opt=apparmor=unconfined",
        "-v",
        "${localEnv:XDG_RUNTIME_DIR}:${localEnv:XDG_RUNTIME_DIR}",
        "--env=DISPLAY=${localEnv:DISPLAY}",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "--add-host=host.docker.internal:host-gateway"
    ],
    "containerEnv": {
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
        "PIPEWIRE_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
        "PULSE_SERVER": "unix:${localEnv:XDG_RUNTIME_DIR}/pulse/native"
    },
    "initializeCommand": "xhost +local: && (pactl list modules | grep -q YouTube_Sink || pactl load-module module-null-sink sink_name=YouTube_Sink sink_properties=device.description=\"YouTube_Sink\")",
    "postCreateCommand": "sudo usermod -aG audio $USER && sudo setfacl -m u:$USER:rw /dev/snd/*",
    "mounts": [
        {
            "source": "${localEnv:HOME}",
            "target": "/home/vscode",
            "type": "bind"
        }
    ],
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",
                "ms-azuretools.vscode-docker",
                "Continue.continue"
            ]
        }
    }
}