{
    "enableConfigurationSquiggles": true,
    "env": {
        "MAJOR": "8"
    },
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/ardour/build/libs/**",
                "${workspaceFolder}/ardour/libs/**",
                "/usr/include/**",
                "/usr/lib/x86_64-linux-gnu/**"
            ],
            "defines": [
                "PACKAGE=\"\"",
                "LOCALEDIR=\"\"",
                "PROGRAM_NAME=\"Ardour\"",
                "VERSIONSTRING=\"8.0.0\""
            ],
            "cppStandard": "c++11"
        }
    ],
    "version": 4
}
