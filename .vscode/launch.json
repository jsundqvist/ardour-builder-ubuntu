{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/ardour-exec-wrapper.sh",
            "args": [
                "${workspaceFolder}/ardour/build/gtk2_ardour/ardour-8.12.0"
            ],
            "cwd": "${cwd}",
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb",
            "additionalSOLibSearchPath": "${workspaceFolder}/ardour/build/libs/*"
        }
    ]
}
