{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ardour/build/gtk2_ardour/ardour-8.4.0",
            "preLaunchTask": "Generate launch.env",
            "envFile": "${workspaceFolder}/launch.env",
            "cwd": "${cwd}",
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb",
            "additionalSOLibSearchPath": "${workspaceFolder}/ardour/build/libs/*",
            "setupCommands": [
                {
                    "description": "Run Ardour's debug target through the PipeWire JACK environment",
                    "text": "set exec-wrapper ${workspaceFolder}/.vscode/ardour-exec-wrapper.sh"
                }
            ]
        }
    ]
}
 